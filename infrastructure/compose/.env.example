# Orbit server
ORBIT_SERVER_HOST=0.0.0.0
ORBIT_SERVER_PORT=8788
ORBIT_SERVER_PUBLISH_ADDR=127.0.0.1
ORBIT_SERVER_LANE_TRANSPORT=tools-agent
ORBIT_SERVER_API_KEY=replace-with-a-long-random-api-key
ORBIT_SERVER_WORKSPACE_ROOT=/workspace/workspaces
ORBIT_SERVER_DOCKER_IMAGE=orbit-worker:local
# Set ORBIT_SERVER_PUBLISH_ADDR=0.0.0.0 if external hosts or Linux worker callbacks must reach the published port.
ORBIT_SERVER_CALLBACK_URL=http://host.docker.internal:8788
ORBIT_SERVER_RECONCILE_INTERVAL_SECS=15
ORBIT_SERVER_ORPHAN_APPROVAL_DELAY_SECS=0
ORBIT_SERVER_ORPHAN_AUTO_RETRY_SECS=0
ORBIT_SERVER_ORPHAN_AUTO_CANCEL_SECS=0
ORBIT_SERVER_ORPHAN_POLICY_RULES=[]
ORBIT_SERVER_STATE_FILE=/var/lib/orbit/server/state.json
ORBIT_AGENT_STORE=/var/lib/orbit/agents
RUST_LOG=info
ORBIT_GITHUB_WEBHOOK_SECRET=
ORBIT_LINEAR_API_TOKEN=
ORBIT_LINEAR_API_URL=https://api.linear.app/graphql
ORBIT_LINEAR_WEBHOOK_SECRET=
ORBIT_GRAPHITE_API_TOKEN=
ORBIT_GRAPHITE_API_URL=https://graphite.dev/api
ORBIT_GRAPHITE_WEBHOOK_SECRET=

# AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
FRONTAL_API_KEY=
FRONTAL_BASE_URL=
XAI_API_KEY=
XAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
BEDROCK_API_KEY=
BEDROCK_BASE_URL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Slack connector
ORBIT_API_URL=http://orbit-server:8788
ORBIT_API_TIMEOUT=30000
ORBIT_API_KEY=replace-with-the-same-orbit-server-api-key
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=replace-with-a-real-32-char-secret
NODE_ENV=production
LOG_LEVEL=info
PORT=3000
MAX_CONCURRENT_TASKS=10
TASK_TIMEOUT=3600000
HEALTH_CHECK_INTERVAL=30000
GITHUB_TOKEN=
SENTRY_DSN=
