# Frontal Orbit Project Environment Configuration
# Copy this file to .env and fill in your actual values

# ===========================================
# AI PROVIDER CONFIGURATION
# ===========================================

# Anthropic
ORBIT_API_KEY=your_anthropic_api_key_here
# Optional bearer token alternative
ORBIT_AUTH_TOKEN=your_anthropic_auth_token_here
ORBIT_BASE_URL=https://api.anthropic.com

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# xAI/Grok
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1

# Frontal (OpenAI-compatible, DEFAULT provider)
FRONTAL_API_KEY=your_frontal_api_key_here
# Frontal AI Gateway endpoint (OpenAI-compatible):
FRONTAL_BASE_URL=https://ai.frontal.dev/v1

# AWS Bedrock (OpenAI-compatible gateway)
BEDROCK_API_KEY=your_bedrock_api_key_here
BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1

# Microsoft Azure OpenAI (OpenAI-compatible)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_BASE_URL=https://YOUR_RESOURCE_NAME.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ===========================================
# CONFIGURATION DIRECTORIES
# ===========================================

ORBIT_CONFIG_HOME=~/.orbit
ORBIT_HOME=~/.orbit
HOME=~/

# ===========================================
# DOCKER & SERVICE CONFIGURATION
# ===========================================

ORBIT_MEMORY_PINECONE_URL=https://YOUR_INDEX_HOST
ORBIT_MEMORY_PINECONE_API_KEY=your_pinecone_api_key_here
ORBIT_MEMORY_PINECONE_NAMESPACE=dev

# Docker-specific paths
ORBIT_SANDBOX_HOME=/workspace/.sandbox-home

# Sandbox backend controls
# Enable Docker fallback backend explicitly (default: disabled)
ORBIT_SANDBOX_ENABLE_DOCKER=0
# Optional Docker image override when ORBIT_SANDBOX_ENABLE_DOCKER=1
ORBIT_SANDBOX_DOCKER_IMAGE=busybox:1.36

# Service Configuration

# ===========================================
# RUNTIME BEHAVIOR
# ===========================================

# Permission Mode
# Options: permissive, read-only, restricted

# Logging
RUST_LOG=info
CARGO_TERM_COLOR=always

# ===========================================
# DEVELOPMENT & TESTING
# ===========================================

# Development
CLAUDE_CODE_UPSTREAM=/path/to/upstream/repo
MOCK_PARITY_REPORT_PATH=/tmp/mock_parity_report.json

# --- orbit-server control plane -------------------------------------------
# Required. Without it the server refuses to start, because every task route
# (create/cancel/complete/approval) would accept unauthenticated requests.
ORBIT_SERVER_API_KEY=change_me

# Set to 1 only to deliberately run an open control plane on a trusted network.
# ORBIT_SERVER_ALLOW_ANONYMOUS=1

# --- Integration webhooks ---------------------------------------------------
# One secret per source, named ORBIT_<SOURCE>_WEBHOOK_SECRET. A delivery to
# /v1/webhooks/<source> is rejected with 401 unless the matching secret is set
# and the request carries a valid `x-<source>-signature` HMAC.
ORBIT_GITHUB_WEBHOOK_SECRET=change_me
# ORBIT_LINEAR_WEBHOOK_SECRET=change_me

# ===========================================
# TOOLS.FRONTAL.DEV CONFIGURATION
# ===========================================

# Orbit CLI configuration for tools.frontal.dev
# Set these when using deployed infrastructure:
# export FRONTAL_BASE_URL="https://tools.frontal.dev/orbit"
# export ORBIT_HOSTED_CALLBACK_URL="https://tools.frontal.dev/orbit/webhooks/tasks"

# Hosted task worker configuration
ORBIT_HOSTED_TASK_FILE=/tmp/orbit_hosted_task.json

# ===========================================
# OPTIONAL OVERRIDES
# ===========================================

# Uncomment and customize as needed
# AUTO_COMPACTION_THRESHOLD=100
# PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH

# ===========================================
# DEPLOYMENT NOTES
# ===========================================

# Local Development:
# - Use infrastructure/compose/.env.example for Docker Compose
# - Use this .env.example for CLI development
# - Default FRONTAL_BASE_URL for local testing

# Cloud Deployment:
# - Use infrastructure/terraform/terraform.tfvars.example
# - Set FRONTAL_BASE_URL="https://tools.frontal.dev/orbit"
# - Configure API keys in Terraform variables
# - External access through NLB at tools.frontal.dev
