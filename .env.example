# Frontal Orbit Project Environment Configuration
# Copy this file to .env and fill in your actual values

# ===========================================
# AI PROVIDER CONFIGURATION
# ===========================================

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional bearer token alternative
ANTHROPIC_AUTH_TOKEN=your_anthropic_auth_token_here
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# xAI/Grok
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1

# Frontal (OpenAI-compatible)
FRONTAL_API_KEY=your_frontal_api_key_here
FRONTAL_BASE_URL=https://api.frontal.ai/v1

# AWS Bedrock (OpenAI-compatible gateway)
BEDROCK_API_KEY=your_bedrock_api_key_here
BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1

# Microsoft Azure OpenAI (OpenAI-compatible)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_BASE_URL=https://YOUR_RESOURCE_NAME.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ===========================================
# CONFIGURATION DIRECTORIES
# ===========================================

ORBIT_CONFIG_HOME=~/.orbit
ORBIT_HOME=~/.orbit
CODEX_HOME=~/.codex
HOME=~/

# ===========================================
# DOCKER & SERVICE CONFIGURATION
# ===========================================

# Database URLs (for docker-compose / external services)
DATABASE_URL=postgresql://orbit:orbit_password@postgres:5432/orbit_db
REDIS_URL=redis://:redis_password@redis:6379
ORBIT_MEMORY_PINECONE_URL=https://YOUR_INDEX_HOST
ORBIT_MEMORY_PINECONE_API_KEY=your_pinecone_api_key_here
ORBIT_MEMORY_PINECONE_NAMESPACE=dev

# Docker-specific paths
ORBIT_SANDBOX_HOME=/workspace/.sandbox-home
SANDBOX_HOME=/workspace/.sandbox-home

# Sandbox backend controls
# Enable Docker fallback backend explicitly (default: disabled)
ORBIT_SANDBOX_ENABLE_DOCKER=0
# Optional Docker image override when ORBIT_SANDBOX_ENABLE_DOCKER=1
ORBIT_SANDBOX_DOCKER_IMAGE=busybox:1.36

# Service Configuration
POSTGRES_DB=orbit_db
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit_password

# ===========================================
# RUNTIME BEHAVIOR
# ===========================================

# Permission Mode
RUSTY_CLAUDE_PERMISSION_MODE=permissive
# Options: permissive, read-only, restricted

# Logging
RUST_LOG=info
CARGO_TERM_COLOR=always

# ===========================================
# DEVELOPMENT & TESTING
# ===========================================

# Development
CLAUDE_CODE_UPSTREAM=/path/to/upstream/repo
MOCK_PARITY_REPORT_PATH=/tmp/mock_parity_report.json

# Webhook (for server mode)
WEBHOOK_SECRET=orbit_webhook_secret

# ===========================================
# OPTIONAL OVERRIDES
# ===========================================

# Uncomment and customize as needed
# AUTO_COMPACTION_THRESHOLD=100
# PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH
