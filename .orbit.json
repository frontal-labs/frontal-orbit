{
  "version": "1.0",
  "providers": {
    "anthropic": {
      "api_key": "${ANTHROPIC_API_KEY}",
      "base_url": "${ANTHROPIC_BASE_URL:-https://api.anthropic.com}",
      "default_model": "claude-opus-4-6"
    },
    "openai": {
      "api_key": "${OPENAI_API_KEY}",
      "base_url": "${OPENAI_BASE_URL:-https://api.openai.com/v1}",
      "default_model": "gpt-4"
    },
    "xai": {
      "api_key": "${XAI_API_KEY}",
      "base_url": "${XAI_BASE_URL:-https://api.x.ai/v1}",
      "default_model": "grok-beta"
    },
    "frontal": {
      "api_key": "${FRONTAL_API_KEY}",
      "base_url": "${FRONTAL_BASE_URL:-https://api.frontal.ai/v1}",
      "default_model": "orbit-proxy"
    }
  },
  "runtime": {
    "default_provider": "anthropic",
    "default_model": "claude-opus-4-6",
    "permission_mode": "danger-full-access",
    "allowed_tools": [
      "bash",
      "read",
      "write",
      "edit",
      "grep",
      "glob",
      "web_search",
      "web_fetch"
    ],
    "tool_restrictions": {
      "bash": {
        "allowed_commands": ["ls", "pwd", "cat", "grep"],
        "blocked_commands": ["rm", "sudo", "chmod"]
      }
    },
    "max_tokens": 4096,
    "temperature": 0.7,
    "timeout": 300,
    "log_level": "info",
    "max_concurrent_requests": 5
  },
  "session": {
    "auto_save": true,
    "max_sessions": 100,
    "session_dir": "${ORBIT_SESSION_DIR:-${HOME}/.orbit/sessions}",
    "compression": "gzip",
    "encryption": false,
    "metadata": {
      "save_system_info": true,
      "save_environment": false,
      "save_git_state": true
    }
  },
  "mcp": {
    "servers_dir": "${ORBIT_MCP_SERVERS_DIR:-${HOME}/.orbit/mcp-servers}",
    "timeout": 30,
    "auto_start": ["filesystem", "context7"],
    "enabled": true,
    "servers": {
      "filesystem": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
        "env": {
          "NODE_ENV": "development"
        },
        "timeout": 30,
        "auto_start": true
      },
      "github": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-github"],
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
        },
        "timeout": 60,
        "auto_start": false
      },
      "context7": {
        "command": "npx",
        "args": ["-y", "@upstash/context7-mcp@latest"],
        "env": {
          "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}",
          "NODE_ENV": "production"
        },
        "timeout": 30,
        "auto_start": true,
        "enabled": true,
        "max_retries": 3,
        "retry_delay": 1000
      }
    }
  },
  "plugins": {
    "plugins_dir": "${ORBIT_CONFIG_DIR:-${HOME}/.orbit}/plugins",
    "auto_load": [],
    "registry_url": "https://plugins.orbit.ai",
    "trusted_sources": ["https://github.com", "https://plugins.orbit.ai"],
    "update_check_interval": "24h",
    "enabled": true
  },
  "ui": {
    "output_format": "text",
    "color_output": true,
    "show_thinking": false,
    "show_tool_calls": true,
    "stream_output": true,
    "terminal_width": 80,
    "markdown_rendering": true,
    "syntax_highlighting": true
  },
  "telemetry": {
    "enabled": false,
    "endpoint": "https://telemetry.orbit.ai/v1/events",
    "sample_rate": 0.1,
    "batch_size": 10,
    "flush_interval": "60s",
    "events": [
      "session_start",
      "session_end",
      "tool_use",
      "error",
      "command_completion"
    ],
    "path": "${ORBIT_CONFIG_DIR:-${HOME}/.orbit}/telemetry.jsonl"
  },
  "prompts": {
    "system": "You are Orbit, a helpful AI engineering assistant that keeps the repository structure intact.",
    "user_context": "repo: {repo}\nbranch: {branch}\nirrelevant_files: {irrelevant_files}",
    "tool_use_template": "Using tool: {tool} args: {args}"
  },
  "performance": {
    "max_concurrent_requests": 5,
    "request_timeout": 300,
    "retry_attempts": 3,
    "retry_delay": "1s",
    "cache_size": "100MB",
    "compression": true
  },
  "security": {
    "encrypt_sessions": false,
    "encrypt_config": false,
    "api_key_rotation": false,
    "audit_logging": true,
    "sandbox_mode": false
  },
  "permissions": {
    "defaultMode": "dontAsk",
    "allowDangerousOverrides": false
  },
  "tools": {
    "bash": {
      "enabled": true,
      "timeout": 120
    },
    "read": {
      "enabled": true
    },
    "write": {
      "enabled": true
    },
    "edit": {
      "enabled": true
    },
    "grep": {
      "enabled": true
    },
    "glob": {
      "enabled": true
    },
    "web_search": {
      "enabled": true
    },
    "web_fetch": {
      "enabled": true
    }
  }
}
