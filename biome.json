{
  "$schema": "https://biomejs.dev/schemas/v2.0.0/schema.json",
  "extends": ["./ultracite.json"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "ignore": [
      "**/node_modules/**",
      "**/target/**",
      "**/dist/**",
      "**/.orbit/**",
      "**/coverage/**",
      "**/bazel-bin/**",
      "**/bazel-out/**",
      "**/bazel-testlogs/**",
      "**/bazel-*",
      "**/*.lock",
      "**/*.sum"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "include": ["sdk/typescript/**", "sdk/typescript/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          }
        }
      }
    }
  ]
}
