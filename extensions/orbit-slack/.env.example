# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# Orbit API Configuration
# For development with tools.frontal.dev infrastructure:
ORBIT_API_URL=http://orbit-server:8788
# For local development:
# ORBIT_API_URL=http://localhost:8788
# For production:
# ORBIT_API_URL=https://tools.frontal.dev/orbit
ORBIT_API_TIMEOUT=30000
ORBIT_API_KEY=replace-with-your-orbit-api-key

# Application Configuration
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# GitHub Integration (Optional)
GITHUB_TOKEN=your-github-token
LINEAR_TOKEN=
LINEAR_API_URL=https://api.linear.app/graphql
GRAPHITE_TOKEN=
GRAPHITE_API_URL=https://graphite.dev/api

# Sentry Configuration (Optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Advanced Configuration
MAX_CONCURRENT_TASKS=10
TASK_TIMEOUT=3600000
HEALTH_CHECK_INTERVAL=30000

# Development Environment Configuration
# When deploying with tools.frontal.dev infrastructure:
# - Use http://orbit-server:8788 for internal communication
# - External access will be through https://tools.frontal.dev/orbit
# - Webhooks should be configured to https://tools.frontal.dev/orbit/webhooks/slack

# Production Environment Configuration
# - Use https://tools.frontal.dev/orbit for ORBIT_API_URL
# - Ensure SLACK_BOT_TOKEN has necessary permissions
# - Configure SENTRY_DSN for error tracking
