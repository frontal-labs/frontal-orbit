{
  "name": "orbit-slack",
  "version": "0.1.0",
  "description": "Orbit Slack agent for autonomous coding operations",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "bun scripts/check-orbit-events.mjs || true",
    "build": "bun build --target bun --minify --sourcemap src/index.ts --outdir dist",
    "build:dev": "bun build --target bun --sourcemap src/index.ts --outdir dist",
    "sync:orbit-events": "cargo run -p orbit-events --bin export-typescript -- src/generated/orbit-events.ts",
    "start": "node dist/index.js",
    "start:bun": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "dev:hot": "bun --watch --hot src/index.ts",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "ci": "vitest run --coverage && biome ci src/"
  },
  "homepage": "https://github.com/frontal-labs/frontal-orbit",
  "bugs": {
    "url": "https://github.com/frontal-labs/frontal-orbit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/frontal-orbit.git",
    "directory": "extensions/orbit-slack"
  },
  "keywords": [
    "slack",
    "orbit",
    "bot",
    "agent",
    "autonomous",
    "ai"
  ],
  "author": "Frontal Labs",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^8.22.0",
    "@slack/bolt": "^3.21.0",
    "@slack/web-api": "^6.12.0",
    "@t3-oss/env-core": "^0.9.2",
    "axios": "^1.7.2",
    "winston": "^3.11.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.7.3",
    "@types/node": "^20.11.30",
    "@vitest/coverage-v8": "^1.3.1",
    "@vitest/ui": "^1.3.1",
    "jsdom": "^23.0.1",
    "msw": "^2.2.3",
    "ultracite": "7.4.4",
    "vitest": "^1.3.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}