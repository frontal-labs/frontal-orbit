{
  "name": "orbit-slack",
  "version": "0.1.0",
  "description": "Orbit Slack agent for autonomous coding operations",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "node scripts/check-orbit-events.mjs",
    "build": "tsc",
    "sync:orbit-events": "cargo run -p orbit-events --bin export-typescript -- src/generated/orbit-events.ts",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "ci": "vitest run --coverage && biome ci src/"
  },
  "keywords": [
    "slack",
    "orbit",
    "autonomous-coding",
    "ai"
  ],
  "author": "Orbit Team",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.16.0",
    "@slack/bolt": "^3.21.0",
    "@slack/web-api": "^6.12.0",
    "@sentry/node": "^8.22.0",
    "axios": "^1.7.2",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "@t3-oss/env-core": "^0.9.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@biomejs/biome": "^1.7.3",
    "@vitest/coverage-v8": "^1.3.1",
    "@vitest/ui": "^1.3.1",
    "jsdom": "^23.0.1",
    "msw": "^2.2.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.3",
    "vitest": "^1.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
