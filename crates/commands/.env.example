# Commands Configuration
# Copy this file to .env and customize for your commands environment

# Configuration Directories for Skills and Commands
ORBIT_CONFIG_HOME=~/.orbit
CODEX_HOME=~/.codex
CLAUDE_CONFIG_DIR=~/.claude
HOME=~/

# These directories are used to locate and load skills/commands:
# - ORBIT_CONFIG_HOME/skills/
# - CODEX_HOME/skills/  
# - CLAUDE_CONFIG_DIR/skills/
# - HOME/.orbit/skills/
# - HOME/.codex/skills/
# - HOME/.claude/skills/

# Default skill installation location will be:
# ORBIT_CONFIG_HOME/skills/ (if set) or
# HOME/.orbit/skills/ (fallback)
