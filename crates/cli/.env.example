# CLI Configuration
# Copy this file to .env and customize for your development environment

# API Authentication (required for AI providers)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_AUTH_TOKEN=your_anthropic_auth_token_here
OPENAI_API_KEY=your_openai_api_key_here
XAI_API_KEY=your_xai_api_key_here
FRONTAL_API_KEY=your_frontal_api_key_here
BEDROCK_API_KEY=your_bedrock_api_key_here
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

# Configuration Directories
ORBIT_CONFIG_HOME=~/.orbit
CLAUDE_CONFIG_DIR=~/.claude
CLAUDE_CONFIG_HOME=~/.claude
CODEX_HOME=~/.codex

# Runtime Behavior
RUSTY_CLAUDE_PERMISSION_MODE=permissive
# Options: permissive, read-only, restricted
ORBIT_SANDBOX_ENABLE_DOCKER=0
# Optional Docker image override when ORBIT_SANDBOX_ENABLE_DOCKER=1
ORBIT_SANDBOX_DOCKER_IMAGE=busybox:1.36

# Logging
RUST_LOG=info
# Options: debug, info, warn, error

# Development & Testing
CLAUDE_CODE_UPSTREAM=/path/to/upstream/repo
MOCK_PARITY_REPORT_PATH=/tmp/mock_parity_report.json

# ===========================================
# TOOLS.FRONTAL.DEV CONFIGURATION
# ===========================================

# For deployed tools.frontal.dev infrastructure:
# Set these environment variables when using the deployed stack:
# export FRONTAL_BASE_URL="https://tools.frontal.dev/orbit"
# export ORBIT_HOSTED_CALLBACK_URL="https://tools.frontal.dev/orbit/webhooks/tasks"

# Hosted task worker configuration
ORBIT_HOSTED_TASK_FILE=/tmp/orbit_hosted_task.json

# Development URL options:
# Local development: http://localhost:8788
# Docker Compose: http://orbit-server:8788
# Deployed: https://tools.frontal.dev/orbit

# Cargo Settings
CARGO_TERM_COLOR=always
