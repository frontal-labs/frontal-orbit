# Runtime Configuration
# Copy this file to .env and customize for your runtime environment

# Configuration Directories
ORBIT_CONFIG_HOME=~/.orbit
ORBIT_HOME=~/.orbit
HOME=~/

# Sandbox Configuration
ORBIT_SANDBOX_HOME=~/.orbit/sandbox
SANDBOX_HOME=~/.orbit/sandbox

# System Paths (ensure these are available in your PATH)
PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

# Optional: Auto-compaction threshold for conversations
# AUTO_COMPACTION_THRESHOLD=100

# OAuth & Authentication Storage
# Credentials will be stored in ORBIT_CONFIG_HOME/oauth/ by default
