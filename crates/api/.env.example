# API Provider Configuration
# Copy this file to .env and fill in your actual API keys

# Anthropic/Claude Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_AUTH_TOKEN=your_anthropic_auth_token_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# xAI/Grok Configuration
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1

# Frontal Configuration (OpenAI-compatible)
FRONTAL_API_KEY=your_frontal_api_key_here
# For tools.frontal.dev deployment:
FRONTAL_BASE_URL=https://tools.frontal.dev/orbit
# For legacy API:
# FRONTAL_BASE_URL=https://api.frontal.ai/v1

# AWS Bedrock Configuration (OpenAI-compatible gateway)
BEDROCK_API_KEY=your_bedrock_api_key_here
BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1

# Azure OpenAI Configuration (OpenAI-compatible)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_BASE_URL=https://YOUR_RESOURCE_NAME.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Optional: Override default model selections
# ANTHROPIC_MODEL=claude-3-opus-20240229
# OPENAI_MODEL=gpt-4
# XAI_MODEL=grok-beta

# API service configuration
# ORBIT_API_HOST=127.0.0.1
# ORBIT_API_PORT=8787
# ORBIT_CLI_BIN=/absolute/path/to/orbit
# ORBIT_API_WORKDIR=/absolute/path/to/workspace
# ORBIT_API_KEY=replace-with-strong-random-secret
# ORBIT_API_ALLOWED_COMMANDS=status,sandbox,version,prompt
# ORBIT_API_COMMAND_TIMEOUT_MS=120000

# ===========================================
# TOOLS.FRONTAL.DEV CONFIGURATION
# ===========================================

# For deployed tools.frontal.dev infrastructure:
# - Set FRONTAL_BASE_URL="https://tools.frontal.dev/orbit"
# - API endpoints available at https://tools.frontal.dev/orbit/
# - Hosted task webhooks: https://tools.frontal.dev/orbit/webhooks/tasks

# Development vs Production URLs:
# Local: http://localhost:8788
# Staging: https://staging-tools.frontal.dev/orbit
# Production: https://tools.frontal.dev/orbit
